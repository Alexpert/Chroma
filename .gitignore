# Build output. No leading slash, so this also covers src/*/bin and src/*/obj
# once the solution is split into several projects.
bin/
obj/

# NuGet
*.nupkg
packages/

# Release archives, built by tools/publish-release.ps1 and attached to a GitHub release
# rather than committed.
dist/

# Visual Studio / Rider / VS Code
.vs/
.idea/
.claude/
*.user
*.suo
*.userprefs
launchSettings.json

# Test and coverage output
[Tt]est[Rr]esult*/
*.coverage
*.trx

# Rendered images produced by running the tool
*.png
*.ppm

# ...except the manual's illustrations and the gallery, which are produced by
# tools/build-manual.ps1 from the scenes they document and committed with them. Without this
# exception the manual ships with no images and no error to say so.
!documents/images/**/*.png

# OS noise
Thumbs.db
.DS_Store

documents_local/
