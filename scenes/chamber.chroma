camera {
  position: [0, 0, 5],
  lookAt:   [0, 0, 0],
  fov:      40
}

// Directional lights do not fall off, but a Lambert surface divides by PI, so an intensity
// that read as 1 before iteration 4 reads as about 3 now.
directionalLight {
  direction: [0, -1, 0],
  color:     [1, 1, 1],
  intensity: 3
}

sphere {
  center:   [0, -0.5, 0],
  radius:   0.5,
  material: material { color: [0.85, 0.3, 0.25], roughness: 0.4 },
}
box {
  min:      [-1, -1.2, -1],
  max:      [1, -1, 1]
  material: material { color: [1, 1, 1], roughness: 0.4 },
}
box {
  min:      [-1.2, -1, -1],
  max:      [-1, 1, 1]
  material: material { color: [1, 0, 0], roughness: 0.4 },
}
box {
  min:      [1, -1, -1],
  max:      [1.2, 1, 1]
  material: material { color: [0, 0, 1], roughness: 0.4 },
}
box {
  min:      [-1, -1, -1.2],
  max:      [1, 1, -1]
  material: material { color: [1, 1, 1], roughness: 0.4 },
}
