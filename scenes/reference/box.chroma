// 'box' takes two opposite corners and is axis-aligned as written: 'min' is the corner with
// the smallest x, y and z, 'max' the one with the largest. Every component of 'min' has to be
// no greater than its counterpart in 'max', or the solid would be empty.
//
// Left is the default box, the two-unit cube from [-1, -1, -1] to [1, 1, 1]. The middle one is
// a slab, the right one a post: the same node, with the corners moved. Nothing about a box is
// tilted until 'rotate' tilts it, which is what the right-hand one shows.

let clay = material { color: [0.75, 0.42, 0.3], roughness: 0.4 };

render { exposure: 0.9 }

camera {
  position: [0, 2.6, 9],
  lookAt:   [0, 0.9, 0],
  fov:      36
}

pointLight {
  position:  [3.5, 6, 5],
  color:     [1, 0.97, 0.92],
  intensity: 240,
  radius:    0.6
}

directionalLight {
  direction: [-0.4, -1, -0.5],
  color:     [0.5, 0.6, 0.85],
  intensity: 0.4
}

plane {
  normal:   [0, 1, 0],
  distance: 0,
  material: material { color: [0.5, 0.5, 0.54], roughness: 0.7 }
}

// The default corners, lifted to stand on the ground.
box {
  min:       [-1, -1, -1],
  max:       [1, 1, 1],
  translate: [-3, 1, 0],
  material:  clay
}

// Wide, thin and shallow: a slab.
box {
  min:      [-1.1, 0, -0.6],
  max:      [1.1, 0.5, 0.6],
  material: clay
}

// The same width and depth, three times as tall, and turned about Y.
box {
  min:       [-0.5, 0, -0.5],
  max:       [0.5, 2.2, 0.5],
  rotate:    [0, 30, 0],
  translate: [3, 0, 0],
  material:  clay
}
