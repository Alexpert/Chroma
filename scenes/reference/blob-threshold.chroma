// The same two components three times, at three thresholds. 'threshold' is the value the sum
// of the fields has to reach for a point to be inside, so raising it pulls the surface inwards
// and eventually pulls the two apart.
//
// Left is 'threshold: 0.25': the two fields overlap far enough out that the surface is one drop.
// The middle is 0.5, where the drop has been pulled in to a waist between the two centres. The
// right is 0.8, which the sum halfway between them no longer reaches: the surface that joined
// them is gone, and one blob is now two balls.
//
// 'threshold' has to be above 0. At or below it, no surface exists at all.

let jade = material { color: [0.3, 0.62, 0.48], roughness: 0.25 };

render { exposure: 0.9 }

camera {
  position: [0, 2, 7.5],
  lookAt:   [0, 0.9, 0],
  fov:      40
}

pointLight {
  position:  [3, 6, 5],
  color:     [1, 0.97, 0.92],
  intensity: 260,
  radius:    0.5
}

directionalLight {
  direction: [-0.4, -1, -0.5],
  color:     [0.5, 0.6, 0.85],
  intensity: 0.4
}

plane {
  normal:   [0, 1, 0],
  distance: 0,
  material: material { color: [0.5, 0.5, 0.54], roughness: 0.7 }
}

blob {
  threshold: 0.25,

  blobSphere { center: [-0.75, 0, 0], radius: 1.1 }
  blobSphere { center: [ 0.75, 0, 0], radius: 1.1 }

  translate: [-2.6, 0.9, 0],
  material:  jade
}

blob {
  threshold: 0.5,

  blobSphere { center: [-0.75, 0, 0], radius: 1.1 }
  blobSphere { center: [ 0.75, 0, 0], radius: 1.1 }

  translate: [0, 0.9, 0],
  material:  jade
}

blob {
  threshold: 0.8,

  blobSphere { center: [-0.75, 0, 0], radius: 1.1 }
  blobSphere { center: [ 0.75, 0, 0], radius: 1.1 }

  translate: [2.6, 0.9, 0],
  material:  jade
}
