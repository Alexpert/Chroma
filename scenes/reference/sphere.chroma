// 'sphere' takes a centre and a radius, and nothing else. The three here are the same node
// written with three pairs of values, sitting on the ground because each centre is exactly
// its own radius above it.

let clay = material { color: [0.75, 0.42, 0.3], roughness: 0.4 };

render { exposure: 0.9 }

camera {
  position: [0, 2.4, 8.5],
  lookAt:   [0, 0.9, 0],
  fov:      36
}

pointLight {
  position:  [3.5, 6, 5],
  color:     [1, 0.97, 0.92],
  intensity: 240,
  radius:    0.6
}

directionalLight {
  direction: [-0.4, -1, -0.5],
  color:     [0.5, 0.6, 0.85],
  intensity: 0.4
}

plane {
  normal:   [0, 1, 0],
  distance: 0,
  material: material { color: [0.5, 0.5, 0.54], roughness: 0.7 }
}

sphere { center: [-2.6, 0.5, 0], radius: 0.5, material: clay }
sphere { center: [-0.4, 0.9, 0], radius: 0.9, material: clay }
sphere { center: [ 2.6, 1.3, 0], radius: 1.3, material: clay }
