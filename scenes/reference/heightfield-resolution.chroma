// 'resolution' is how many CELLS the grid has on a side, so the samples are one more than that
// in each direction: 'resolution: 4' is a 5 by 5 grid. It goes with 'height' and says how
// finely the function is sampled, never what shape it describes.
//
// The three fields here are one function at 4, 16 and 128 cells. Raising it refines the same
// landscape rather than producing a different one, because the function is called with the x
// and z of each sample and not with its index.
//
// The default is 128, which is 16,641 samples and loads instantly. The largest allowed is
// 1,024, which is a million calls of your function and takes a few seconds.

let ivory = material { color: [0.82, 0.8, 0.74], roughness: 0.35 };

camera {
  position: [0, 3, 8.5],
  lookAt:   [0, 0.2, 0],
  fov:      42
}

pointLight {
  position:  [4, 7, 6],
  color:     [1, 0.97, 0.92],
  intensity: 340,
  radius:    0.5
}

directionalLight {
  direction: [-0.4, -1, -0.5],
  color:     [0.5, 0.6, 0.85],
  intensity: 0.6
}

plane {
  normal:   [0, 1, 0],
  distance: -1.2,
  material: material { color: [0.5, 0.5, 0.54], roughness: 0.7 }
}

function terrain(x, z) {
  return perlin(x * 1.6, z * 1.6) * 0.9 + perlin(x * 3.9, z * 3.9) * 0.3;
}

heightField {
  height:     terrain,
  resolution: 4,
  material:   ivory,
  scale:      [1.3, 1.1, 1.3],
  translate:  [-2.9, 0, 0]
}

heightField {
  height:     terrain,
  resolution: 16,
  material:   ivory,
  scale:      [1.3, 1.1, 1.3]
}

heightField {
  height:     terrain,
  resolution: 128,
  material:   ivory,
  scale:      [1.3, 1.1, 1.3],
  translate:  [2.9, 0, 0]
}
