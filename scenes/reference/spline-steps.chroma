// 'steps' is how many straight segments each Bezier curve is flattened into, and the three
// lathes here are the same outline at three values of it.
//
// Left is 'steps: 1', which reduces every curve to the straight line between its ends. The
// middle is 'steps: 3'. The right is 'steps: 16', where the silhouette has become the curve
// the control points describe. Flattening happens while the scene loads, so a fine value costs
// nothing to trace: what it spends is points, and the limit there is 64 after flattening.

let clay = material { color: [0.75, 0.42, 0.3], roughness: 0.3 };

render { exposure: 0.9 }

camera {
  position: [0, 1.8, 6.5],
  lookAt:   [0, 1, 0],
  fov:      36
}

pointLight {
  position:  [2.5, 5, 4],
  color:     [1, 0.97, 0.92],
  intensity: 180,
  radius:    0.4
}

directionalLight {
  direction: [-0.4, -1, -0.5],
  color:     [0.5, 0.6, 0.85],
  intensity: 0.4
}

plane {
  normal:   [0, 1, 0],
  distance: 0,
  material: material { color: [0.5, 0.5, 0.54], roughness: 0.7 }
}

// The outline is three cubic curves, written once and bound to a name.
let outline = [
  // P0        control     control     P3
  0,    0,     0.55, 0,    0.75, 0.1,   0.75, 0.45,
  0.75, 0.45,  0.75, 0.9,  0.28, 1.0,   0.30, 1.45,
  0.30, 1.45,  0.32, 1.8,  0.62, 1.85,  0,    2.0
];

lathe {
  spline:    "bezier",
  steps:     1,
  points:    outline,
  translate: [-1.7, 0, 0],
  material:  clay
}

lathe {
  spline:   "bezier",
  steps:    3,
  points:   outline,
  material: clay
}

lathe {
  spline:    "bezier",
  steps:     16,
  points:    outline,
  translate: [1.7, 0, 0],
  material:  clay
}
