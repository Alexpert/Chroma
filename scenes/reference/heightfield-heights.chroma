// The other way to give a height field its samples: 'heights', a grid of numbers written out
// in the scene instead of computed by a function.
//
// The grid has to be square -- as many rows as there are numbers in a row -- and it is its own
// resolution, so 'resolution' means nothing beside it and is refused. A grid of five rows of
// five is a field of four cells a side, which is what the left-hand one is.
//
// Right is a three by three grid, which is two cells a side and the smallest useful field
// there is. Use 'heights' for a grid of this size and 'height' for anything finer: writing out a
// fine grid by hand is slow to load and no easier to read.

let ivory = material { color: [0.82, 0.8, 0.74], roughness: 0.35 };
let clay  = material { color: [0.75, 0.42, 0.3], roughness: 0.4 };

camera {
  position: [0, 3, 7],
  lookAt:   [0, 0.2, 0],
  fov:      40
}

pointLight {
  position:  [4, 7, 6],
  color:     [1, 0.97, 0.92],
  intensity: 320,
  radius:    0.5
}

directionalLight {
  direction: [-0.4, -1, -0.5],
  color:     [0.5, 0.6, 0.85],
  intensity: 0.6
}

plane {
  normal:   [0, 1, 0],
  distance: -1.2,
  material: material { color: [0.5, 0.5, 0.54], roughness: 0.7 }
}

// Five rows of five: a ridge across the middle and a dip in one corner.
heightField {
  heights: [
    [0.0, 0.1, 0.3, 0.1, 0.0],
    [0.1, 0.5, 0.9, 0.4, 0.1],
    [0.3, 0.9, 1.4, 0.8, 0.2],
    [0.1, 0.4, 0.8, 0.3, 0.0],
    [0.0, 0.1, 0.2, 0.0, 0.0]
  ],
  material:  ivory,
  scale:     [1.4, 1, 1.4],
  translate: [-1.7, 0, 0]
}

// Three rows of three: two cells a side, and every facet is visible.
heightField {
  heights: [
    [0, 0.4, 0],
    [0.4, 1.2, 0.4],
    [0, 0.4, 0]
  ],
  material:  clay,
  scale:     [1.4, 1, 1.4],
  translate: [1.7, 0, 0]
}
