// 'color' is the base colour of a material, in linear values from 0 to 1 per channel. On a
// dielectric -- anything with 'metallic: 0', which is the default -- it is the colour the
// surface scatters, so it is what the eye reads as "the colour of the object".
//
// Five spheres, same roughness, five colours. The last is [1, 1, 1]: white, and no brighter
// than the light falling on it, since a colour reflects light rather than making any.

render { exposure: 0.9 }

camera {
  position: [0, 1.6, 9],
  lookAt:   [0, 0.8, 0],
  fov:      34
}

pointLight {
  position:  [1.5, 5, 4.5],
  color:     [1, 0.97, 0.92],
  intensity: 130,
  radius:    0.4
}

directionalLight {
  direction: [-0.4, -1, -0.5],
  color:     [0.6, 0.68, 0.9],
  intensity: 0.5
}

plane {
  normal:   [0, 1, 0],
  distance: 0,
  material: material { color: [0.45, 0.45, 0.48], roughness: 0.7 }
}

let colors = [
  [0.8, 0.2, 0.2],
  [0.85, 0.55, 0.15],
  [0.25, 0.55, 0.3],
  [0.2, 0.35, 0.7],
  [1, 1, 1]
];

for (let i = 0; i < colors.length; i++) {
  sphere {
    center:   [(i - 2) * 1.6, 0.7, 0],
    radius:   0.7,
    material: material { color: colors[i], roughness: 0.35 }
  }
}
