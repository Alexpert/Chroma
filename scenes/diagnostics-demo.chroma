// THIS FILE IS BROKEN ON PURPOSE.
//
// It exists to exercise error reporting: loading it must produce four diagnostics in a
// single run -- not one, then another after each fix -- each with an exact line and
// column, and a non-zero exit code. Do not "fix" it.

let radius = 1.3;
let radius = 2.0;                 // 1. redeclaring a name is an error, not a shadow

camera {
  position: [0, 2, -5],
  lookAt:   [0, 0, 0],
  fov:      45
}

pointLight { position: [2, 4, -3] }

sphere {
  center: [0, 0, 0],
  raduis: radius                  // 2. misspelled field
}

box {
  min: [-1, -1],                  // 3. a vector of the wrong length
  max: [1, 1, 1]
}

difference {
  box { min: [-1, -1, -1], max: [1, 1, 1] }
}                                 // 4. difference needs at least two operands
