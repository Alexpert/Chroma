let glass = material {
  roughness:    0,
  transmission: 1,
  ior:          1.5
};

render {
  maxBounces: 8,
  exposure:   1
}

camera {
  position: [9, 9, 9],
  lookAt:   [0, 0, 0],
  fov:      70
}

pointLight {
  position:  [0, 15, 0],
  color:     [1, 0.95, 0.88],
  intensity: 300,
  radius:    0.55
}

intersection{
    sphere {
        center:   [0, -5.5, 0],
        radius:   4,
    }
    sphere {
        center:   [0, 1.5, 0],
        radius:   4,
    }
    material: glass
}

difference {
    difference {
        box {
            min: [-10, -10,   -10], max: [ 10,  10,  10]
        }
        box {
            min: [-9, -9,   -9], max: [ 9,  9,  9]
        }
    }
    
    cylinder {
        base: [0, 8, 0],
        cap: [0, 11, 0],
        radius: 3
    }
}