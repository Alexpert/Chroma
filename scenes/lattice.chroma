// The deliverable of iteration 8: a 5x5x5 lattice of spheres joined by cylinders, with the
// eight corner cells in a second material.
//
// Written out by hand this scene is 425 solids and about four hundred lines, which is why
// it had never been written. Everything below the lights is twenty-five lines, and every one
// of the iteration's features is in them: nested loops, 'if' deciding whether a strut
// exists, a ternary deciding which material a cell wears, comparisons and boolean
// operators, and a 'let' inside a block naming a value the entries around it share.
//
// Each cell is a 'union' rather than a handful of top-level solids, which matters for a
// reason that is invisible here and would not be if these were glass: top-level solids are
// unioned but NOT merged, so the faces where a strut enters a node would survive.

let n     = 5;
let step  = 1.2;
let mid   = (n - 1) / 2;
let node  = 0.3;
let strut = 0.1;

let steel = material { color: [0.55, 0.58, 0.62], metallic: 1, roughness: 0.28 };
let gold  = material { color: [1.00, 0.71, 0.29], metallic: 1, roughness: 0.15 };

render { exposure: 1.2 }

camera     { position: [6.5, 5, 8.5], lookAt: [0, 0, 0], fov: 42 }
pointLight { position: [4, 7, 6], color: [1, 1, 1], intensity: 300, radius: 0.8 }
directionalLight { direction: [-1, -1.4, -0.8], color: [0.55, 0.6, 0.75] }

for (let x = 0; x < n; x++) {
  for (let y = 0; y < n; y++) {
    for (let z = 0; z < n; z++) {
      union {
        let p      = ([x, y, z] - mid) * step;
        let corner = (x == 0 || x == n - 1) && (y == 0 || y == n - 1) && (z == 0 || z == n - 1);

        sphere { center: p, radius: node }

        // The far faces of the lattice have no neighbour to reach for.
        if (x < n - 1) { cylinder { base: p, cap: p + [step, 0, 0], radius: strut } }
        if (y < n - 1) { cylinder { base: p, cap: p + [0, step, 0], radius: strut } }
        if (z < n - 1) { cylinder { base: p, cap: p + [0, 0, step], radius: strut } }

        material: corner ? gold : steel
      }
    }
  }
}
