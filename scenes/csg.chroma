// The boolean operators.
//
// Left:  a box with a spherical bite taken out of it -- the case that cannot be rendered
//        correctly without exact CSG, because the visible surface inside the cavity is the
//        far side of the sphere with its normal reversed.
// Right: a rounded cube drilled through on all three axes, which nests every operator.

let radius = 1.3;
let red    = material { color: [0.8, 0.2, 0.2], roughness: 0.4 };

// Glossy, but deliberately NOT metallic. A metal has no diffuse lobe: it only reflects its
// surroundings, and the surroundings here are empty space, so `metallic: 1` renders this
// solid nearly black. That is correct rather than broken -- see scenes/cornell.chroma for a
// metal in a room, where there is something for it to reflect.
let steel  = material { color: [0.6, 0.62, 0.68], roughness: 0.18 };

let box = box    { min: [-1, -1, -1], max: [1, 1, 1] };

render { exposure: 1.3 }

// Right-handed, +Z towards the viewer: the camera sits at positive z and looks down -z.
camera {
  position: [0, 2, 6],
  lookAt:   [0, 0, 0],
  fov:      45
}

// Intensity is large because point lights fall off with the square of the distance; this
// one is about 5.4 units away, so it arrives divided by ~29.
pointLight       { position: [2, 4, 3], color: [1, 1, 1], intensity: 55, radius: 0.4 }
directionalLight { direction: [-1, -1, -1], color: [0.8, 0.8, 1.1] }

difference {
  box
  sphere { center: [0, 0, 0], radius: radius }

  material:  red,
  translate: [-1.8, 0, 0]
}

difference {
  intersection {
    box
    sphere { center: [0, 0, 0], radius: 1.35 }
  }

  union {
    cylinder { base: [0, -2, 0], cap: [0, 2, 0], radius: 0.5 }
    cylinder { base: [-2, 0, 0], cap: [2, 0, 0], radius: 0.5 }
    cylinder { base: [0, 0, -2], cap: [0, 0, 2], radius: 0.5 }
  }

  material:  steel,
  translate: [1.8, 0, 0],
  rotate:    [0, 20, 0]
}
