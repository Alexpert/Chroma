// A full chess set. THIS SCENE DOES NOT COMPILE, and that is what it is for.
//
// It was written to find the edges of the renderer rather than to be pretty, and it found one.
// Everything in the language is in here at once: all ten primitives, all three operators,
// nested functions, loops and conditionals, Bezier lathes, glass with absorption, a
// scattering medium, five lights and an emissive panel. Per-scene code generation removed the
// limits that made a scene like this impossible to express, and the only honest way to find
// the new limits was to write something that goes looking for them.
//
// What it runs into:
//
//   line 65886, column 1:  error: too many instructions
//
// The driver will not compile more than about 65,000 assembly instructions into one program,
// and thirty-two turned pieces are past it. What it counts is instructions AFTER inlining every
// call and unrolling every loop with a constant bound, so the generated line count on the
// console is only a rough guide to how close a scene is.
//
// Measured on an RTX 4070 SUPER, driver 4.6, by cutting this scene down:
//
//   32 pieces + board   10,514 lines   refused
//   32 pieces, no board  5,002 lines   refused -- so it is the PIECES, not the 64 squares
//   20 pieces + board    6,588 lines   refused
//   16 pieces + board    5,967 lines   compiles
//
// Neither a newer OpenGL nor a compute shader moves it: both were tried and both refuse at the
// same number, one instruction apart. Sharing the body of identical pieces cuts the source by a
// third and the ceiling by almost nothing, because the driver inlines the copies back. The full
// account is in documents/gpu-backends.md.
//
// scenes/chess-half.chroma is the same set as a sixteen-man middlegame position, which fits and
// renders. Keep this file: it is the artifact that says where the wall is, and it is what any
// future work on instancing has to make compile.

let files  = 8;
let half   = 4;                 // half the board, in squares
let top    = 0.12;              // the surface pieces stand on
let detail = 3;                 // Bezier steps per curve: the span width of every turned piece

// --- Materials --------------------------------------------------------------------------

let lightSquare = material { color: [0.82, 0.78, 0.70], roughness: 0.22 };
let darkSquare  = material { color: [0.16, 0.13, 0.12], roughness: 0.18 };
let frame       = material { color: [0.72, 0.55, 0.24], metallic: 1, roughness: 0.20 };
let floor       = material { color: [0.24, 0.24, 0.26], roughness: 0.75 };

let ivory    = material { color: [0.88, 0.84, 0.74], roughness: 0.35 };
let obsidian = material { color: [0.07, 0.07, 0.09], roughness: 0.12 };

// The kings are clear glass. `color` is unused by a fully transmissive surface -- what is not
// reflected goes through rather than scattering -- so the tint comes from `absorption`, which
// is a rate per world unit: the thick base of a king is visibly deeper than its neck.
let clearGlass = material {
  roughness:    0,
  transmission: 1,
  ior:          1.52,
  absorption:   [0.4, 0.15, 0.05]
};

let smokedGlass = material {
  roughness:    0.04,
  transmission: 1,
  ior:          1.52,
  absorption:   [1.6, 1.9, 2.2]
};

// The queens are glass with a medium inside them: light that enters scatters before it
// leaves, which is what separates jade from tinted glass. It is the most expensive material
// in the renderer -- one scattering surface anywhere compiles the volume integral into the
// whole shader -- so two queens is a deliberate, minimal dose of it.
let paleJade = material {
  roughness:    0.05,
  transmission: 1,
  ior:          1.48,
  absorption:   [0.25, 0.10, 0.20],
  scattering:   2.2,
  anisotropy:   0.3
};

let darkJade = material {
  roughness:    0.05,
  transmission: 1,
  ior:          1.48,
  absorption:   [0.9, 0.5, 1.1],
  scattering:   2.6,
  anisotropy:   0.3
};

// --- The board --------------------------------------------------------------------------

// A prism for the outer moulding, hollowed by the box the squares sit in. The prism is a
// solid like any other, so `difference` takes it without knowing what shape it is.
difference {
  prism {
    bottom: -0.06,
    top:    0.18,
    points: [
       5.0,  0.0,   3.54,  3.54,   0.0,  5.0,  -3.54,  3.54,
      -5.0,  0.0,  -3.54, -3.54,   0.0, -5.0,   3.54, -3.54
    ]
  }

  box { min: [-4.02, -0.2, -4.02], max: [4.02, 0.3, 4.02] }

  material: frame
}

for (let x = 0; x < files; x++) {
  for (let z = 0; z < files; z++) {
    object {
      box {
        min: [x - half,     0, z - half],
        max: [x - half + 1, top, z - half + 1]
      }
      material: (x + z) % 2 == 0 ? darkSquare : lightSquare
    }
  }
}

plane { normal: [0, 1, 0], distance: -0.4, material: floor }

// --- The pieces -------------------------------------------------------------------------
//
// Every profile is a closed outline in (radius, y) revolved about Y, and every curved one is
// written as cubic Bezier curves in POV-Ray's grouping: four (radius, y) points per curve,
// each curve starting where the last one ended. The outline closes back down the axis, which
// is the degenerate edge at radius 0 that costs nothing.

// Sixteen of these, so it gets the coarsest tessellation that still reads as turned.
function pawn(x, z) {
  return lathe {
    spline: "bezier",
    steps:  detail,
    points: [
      0,    0,      0.07, 0,      0.14, 0,      0.20, 0,
      0.20, 0,      0.20, 0.05,   0.16, 0.08,   0.10, 0.13,
      0.10, 0.13,   0.06, 0.22,   0.06, 0.28,   0.11, 0.33,
      0.11, 0.33,   0.17, 0.40,   0.14, 0.52,   0,    0.54
    ],
    translate: [x - half + 0.5, top, z - half + 0.5]
  };
}

// The one piece whose outline is genuinely straight, so it is a linear lathe -- and the one
// that needs its crenellations cut out afterwards, which is what `difference` is for.
function rook(x, z) {
  return difference {
    lathe {
      points: [
        0,    0,
        0.22, 0,
        0.22, 0.06,
        0.16, 0.11,
        0.15, 0.34,
        0.21, 0.38,
        0.21, 0.52,
        0,    0.52
      ]
    }

    box { min: [-0.30, 0.44, -0.06], max: [0.30, 0.60,  0.06] }
    box { min: [-0.06, 0.44, -0.30], max: [0.06, 0.60,  0.30] }
    box { min: [-0.09, 0.48, -0.09], max: [0.09, 0.60,  0.09] }

    translate: [x - half + 0.5, top, z - half + 0.5]
  };
}

// A turned body with the mitre slot cut through it, and a bead on top.
function bishop(x, z, facing) {
  return union {
    difference {
      lathe {
        spline: "bezier",
        steps:  detail,
        points: [
          0,    0,      0.07, 0,      0.14, 0,      0.20, 0,
          0.20, 0,      0.20, 0.05,   0.17, 0.08,   0.11, 0.14,
          0.11, 0.14,   0.06, 0.26,   0.07, 0.34,   0.12, 0.42,
          0.12, 0.42,   0.16, 0.52,   0.10, 0.60,   0,    0.66
        ]
      }

      box {
        min:    [-0.02, 0.44, -0.20],
        max:    [ 0.02, 0.70,  0.20],
        rotate: [0, 0, 22]
      }
    }

    sphere { center: [0, 0.68, 0], radius: 0.045 }

    rotate:    [0, facing, 0],
    translate: [x - half + 0.5, top, z - half + 0.5]
  };
}

// The one piece a lathe cannot make, so it is assembled: a turned base, a swept neck, a blob
// for the muzzle, two cones for the ears, and a notch cut for the mouth. Five primitives and
// two operators for one piece.
function knight(x, z, facing) {
  return difference {
    union {
      lathe {
        spline: "bezier",
        steps:  detail,
        points: [
          0,    0,      0.08, 0,      0.15, 0,      0.21, 0,
          0.21, 0,      0.21, 0.06,   0.16, 0.11,   0,    0.20
        ]
      }

      sphereSweep {
        spheres: [
          0,    0.13, -0.02,  0.135,
          0.0,  0.28,  0.00,  0.110,
          0.0,  0.42,  0.05,  0.100,
          0.0,  0.52,  0.13,  0.085
        ]
      }

      blob {
        threshold: 0.5,
        blobSphere { center: [0, 0.52, 0.10], radius: 0.20, strength: 1 }
        blobSphere { center: [0, 0.54, 0.19], radius: 0.16, strength: 1 }
        blobSphere { center: [0, 0.48, 0.26], radius: 0.12, strength: 1 }
      }

      cone { base: [-0.06, 0.56, -0.02], cap: [-0.08, 0.70, -0.05], baseRadius: 0.045, capRadius: 0 }
      cone { base: [ 0.06, 0.56, -0.02], cap: [ 0.08, 0.70, -0.05], baseRadius: 0.045, capRadius: 0 }
    }

    box { min: [-0.12, 0.44, 0.16], max: [0.12, 0.475, 0.34] }

    rotate:    [0, facing, 0],
    translate: [x - half + 0.5, top, z - half + 0.5]
  };
}

// The widest root in the scene: a 16-span lathe, a half-torus collar and six crown beads,
// which the union adds together.
function queen(x, z) {
  return union {
    lathe {
      spline: "bezier",
      steps:  detail,
      points: [
        0,    0,      0.08, 0,      0.16, 0,      0.23, 0,
        0.23, 0,      0.23, 0.06,   0.19, 0.10,   0.12, 0.17,
        0.12, 0.17,   0.07, 0.32,   0.08, 0.44,   0.14, 0.54,
        0.14, 0.54,   0.20, 0.62,   0.18, 0.68,   0,    0.70
      ]
    }

    // Half a ring, which is what `intersection` is for: a torus is 2 spans, a box is 1, and
    // the sweep that combines them cannot produce more than 2.
    intersection {
      torus { center: [0, 0.60, 0], majorRadius: 0.17, minorRadius: 0.035 }
      box   { min: [-0.25, 0.60, -0.25], max: [0.25, 0.70, 0.25] }
    }

    sphere { center: [ 0.00, 0.735, 0.00], radius: 0.05 }
    sphere { center: [ 0.15, 0.665, 0.00], radius: 0.04 }
    sphere { center: [-0.15, 0.665, 0.00], radius: 0.04 }
    sphere { center: [ 0.00, 0.665, 0.15], radius: 0.04 }
    sphere { center: [ 0.00, 0.665, -0.15], radius: 0.04 }

    translate: [x - half + 0.5, top, z - half + 0.5]
  };
}

// The tallest piece, with a cross on top built from two boxes and a dome cut from a sphere.
function king(x, z) {
  return union {
    lathe {
      spline: "bezier",
      steps:  detail,
      points: [
        0,    0,      0.08, 0,      0.17, 0,      0.24, 0,
        0.24, 0,      0.24, 0.06,   0.20, 0.10,   0.13, 0.18,
        0.13, 0.18,   0.08, 0.34,   0.09, 0.48,   0.15, 0.58,
        0.15, 0.58,   0.21, 0.66,   0.19, 0.72,   0,    0.74
      ]
    }

    // The upper half of a sphere, and the cheapest possible use of `intersection`.
    intersection {
      sphere { center: [0, 0.72, 0], radius: 0.09 }
      box    { min: [-0.1, 0.72, -0.1], max: [0.1, 0.82, 0.1] }
    }

    box { min: [-0.022, 0.78, -0.022], max: [0.022, 0.95, 0.022] }
    box { min: [-0.075, 0.865, -0.022], max: [0.075, 0.905, 0.022] }

    translate: [x - half + 0.5, top, z - half + 0.5]
  };
}

// --- Setting them out -------------------------------------------------------------------
//
// Two armies, eight files each, with the back rank chosen by an if-chain on the file index.
// The loop is what makes this scene 32 pieces of source rather than 32 pieces of typing, and
// it is also what makes the generated shader large: nothing is shared between two knights
// that stand on different squares yet.

for (let army = 0; army < 2; army++) {
  let backRank  = army == 0 ? 0 : 7;
  let pawnRank  = army == 0 ? 1 : 6;
  let facing    = army == 0 ? 0 : 180;

  let solid = army == 0 ? ivory : obsidian;
  let jade  = army == 0 ? paleJade : darkJade;
  let glass = army == 0 ? clearGlass : smokedGlass;

  for (let f = 0; f < files; f++) {
    object {
      pawn(f, pawnRank)
      material: solid
    }

    if (f == 0 || f == 7) {
      object { rook(f, backRank) material: solid }
    } else if (f == 1 || f == 6) {
      object { knight(f, backRank, facing) material: solid }
    } else if (f == 2 || f == 5) {
      object { bishop(f, backRank, facing) material: solid }
    } else if (f == 3) {
      object { queen(f, backRank) material: jade }
    } else {
      object { king(f, backRank) material: glass }
    }
  }
}

// --- Light ------------------------------------------------------------------------------
//
// Five declared lights plus an emissive panel. The panel is not decoration: a `pointLight` is
// not geometry, so a ray can never land on one, and the caustics under the glass kings need a
// light a path can actually reach. It is also the slowest thing in the scene to converge.

render {
  maxBounces: 8,
  exposure:   1.15
}

camera {
  position: [0, 5.6, 8.4],
  lookAt:   [0, 0.45, -0.2],
  fov:      38
}

// A soft key from the front left. `radius` turns the point into a sphere, which is what gives
// the pieces a penumbra instead of a stencilled edge.
pointLight { position: [-5.5, 7.0,  5.0], color: [1.00, 0.96, 0.90], intensity: 520, radius: 0.9 }
pointLight { position: [ 6.0, 5.5, -3.0], color: [0.78, 0.86, 1.00], intensity: 300, radius: 0.6 }
pointLight { position: [ 0.0, 2.2,  6.5], color: [1.00, 0.88, 0.72], intensity: 120, radius: 0.4 }

directionalLight { direction: [-0.4, -1, -0.35], color: [0.22, 0.26, 0.34], intensity: 1 }
directionalLight { direction: [ 0.6, -0.5,  0.6], color: [0.10, 0.09, 0.12], intensity: 1 }

// The panel a caustic can be traced back to.
box {
  min: [-2.6, 6.4, -2.0],
  max: [ 2.6, 6.5,  2.0],
  material: material { color: [0, 0, 0], emission: [3.2, 3.1, 3.0] }
}
