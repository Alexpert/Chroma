function cube(step) {
    if (step == 0) {
        return box {
            min: [-1, -1, -1]
            max: [1, 1, 1]
        };
    } else {
        return union {
            for (let x = -1; x < 2; x++) {
                for (let y = -1; y < 2; y++) {
                    for (let z = -1; z < 2; z++) {
                        if (!(x == 0 && y == 0) && !(x == 0 && z == 0) && !(y == 0 && z == 0)) {
                            object {
                                cube(step -1),
                                translate: [x*2, y*2, z*2],
                            }
                        }
                    }
                }
            }
            scale: [1/3, 1/3, 1/3]
        };
    }
}

camera {
  position: [4, 4, 4],
  lookAt:   [0, 0, 0],
  fov:      50
}
directionalLight { direction: [-1, -1, -1], color: [0.8, 0.8, 1.1] }

cube(3);