// The deliverable of iteration 5: refraction, Fresnel, Beer-Lambert absorption, and a
// caustic.
//
// Four things to look at, each testing one part and nothing else:
//
//   1. The sphere in the middle shows the coloured bars behind it INVERTED -- the red bar
//      on the left of the wall appears on the right through the glass. That is refraction;
//      nothing else produces it.
//   2. The two teal slabs on the left are the SAME material. The thicker one is visibly
//      darker, because Beer-Lambert decays with distance travelled rather than scaling by a
//      constant. Three times the thickness is not three times the tint.
//   3. The two spheres on the right overlap under `union`. There is no seam where they
//      cross, because an interval union coalesces the spans and the interior faces stop
//      existing -- see documents/csg-raytracing.md. This is what a POV-Ray `merge` is for,
//      and why this renderer needs no such keyword.
//   4. Under the middle sphere, a bright patch on the floor: the caustic.
//
// The only light is the emissive panel on the ceiling, and that is not decoration. A
// caustic reaches the eye along a floor -> glass -> glass -> light path, and a `pointLight`
// is not geometry, so a ray can never land on one. An emissive solid can. The price is
// noise: this scene converges more slowly than any other here, and the caustic is the last
// thing in it to settle.

let white = material { color: [0.75, 0.75, 0.75], roughness: 1 };
let grey  = material { color: [0.45, 0.45, 0.45], roughness: 1 };

// Polished window glass. `color` is unused by a fully transmissive surface: what is not
// reflected goes through rather than scattering, so there is no diffuse lobe to tint.
let glass = material {
  roughness:    0,
  transmission: 1,
  ior:          1.5
};

// The same glass, absorbing red fastest and green next, which leaves teal. These are rates
// per world unit, not fractions: doubling the thickness squares the transmittance.
let teal = material {
  roughness:    0,
  transmission: 1,
  ior:          1.5,
  absorption:   [2.2, 0.5, 0.7]
};

// Eight bounces: crossing a single glass sphere already spends two before the ray has been
// anywhere, and the caustic path needs four of its own.
render {
  maxBounces: 8,
  exposure:   1.1
}

// Inside the room, close to its mouth. A closed box means no ray escapes into the black
// environment, which is what keeps the energy balance checkable.
camera {
  position: [0, -0.2, 5.5],
  lookAt:   [0, -1.5, 0],
  fov:      50
}

// --- The room ------------------------------------------------------------------------

box { min: [-4.2, -3.2, -4.2], max: [ 4.2, -3.0,  6.2], material: white }  // floor
box { min: [-4.2,  3.0, -4.2], max: [ 4.2,  3.2,  6.2], material: white }  // ceiling
box { min: [-4.2, -3.0, -4.4], max: [ 4.2,  3.0, -4.2], material: white }  // back wall
box { min: [-4.4, -3.0, -4.2], max: [-4.2,  3.0,  6.2], material: grey }   // left wall
box { min: [ 4.2, -3.0, -4.2], max: [ 4.4,  3.0,  6.2], material: grey }   // right wall
box { min: [-4.2, -3.0,  6.2], max: [ 4.2,  3.0,  6.4], material: white }  // behind the eye

// The one light. Large on purpose: a small emissive source is found by too few paths to
// converge, and a caustic needs the rarest paths of all.
box {
  min: [-1.8, 2.85, -1.5],
  max: [ 1.8, 3.00,  1.5],
  material: material { color: [0, 0, 0], emission: [11, 10.6, 10] }
}

// --- 1. Refraction: bars seen through a sphere ----------------------------------------

// Flat on the back wall. Through the sphere their order reverses, left to right.
box { min: [-1.7, -2.4, -4.2], max: [-1.0, 0.4, -4.15], material: material { color: [0.75, 0.1, 0.08], roughness: 1 } }
box { min: [-0.35, -2.4, -4.2], max: [ 0.35, 0.4, -4.15], material: material { color: [0.15, 0.6, 0.15], roughness: 1 } }
box { min: [ 1.0, -2.4, -4.2], max: [ 1.7, 0.4, -4.15], material: material { color: [0.12, 0.2, 0.8], roughness: 1 } }

// --- 4. The caustic: a ball lens above the floor --------------------------------------

// A sphere of index 1.5 focuses about half a radius past its own surface, so this sits at
// roughly that height above the floor and the bright patch lands under it.
sphere {
  center:   [0, -1.7, 0.5],
  radius:   0.85,
  material: glass
}

// --- 2. Absorption: one material, two thicknesses -------------------------------------

box { min: [-3.6, -2.6, -0.1], max: [-2.6, 0.4, 0.1], material: teal }   // 0.2 thick
box { min: [-2.3, -2.6, -0.3], max: [-1.3, 0.4, 0.3], material: teal }   // 0.6 thick

// --- 3. Two glass solids that overlap, with no seam -----------------------------------

union {
  sphere { center: [2.0, -2.15, 0.3], radius: 0.75 }
  sphere { center: [2.8, -2.15, 0.3], radius: 0.75 }
  material: glass
}
