// What '%' is for. A board is 64 tiles and 'every other one' is not something the rest of the
// language can say: '(x + z) % 2 == 0' is the whole rule, and it decides the material.
//
// '%' follows C and JavaScript -- it is a remainder, so it takes the sign of its left operand,
// and it does not insist on whole numbers. Here both operands are counters, which is the case
// it exists for.

let n     = 8;
let tile  = 0.62;
let dark  = material { color: [0.12, 0.13, 0.16], roughness: 0.35 };
let light = material { color: [0.78, 0.75, 0.68], roughness: 0.35 };

render { exposure: 0.9 }

camera {
  position: [0, 3.6, 5.4],
  lookAt:   [0, 0, -0.2],
  fov:      42
}

pointLight {
  position:  [3, 6, 4],
  color:     [1, 0.97, 0.92],
  intensity: 210,
  radius:    0.5
}

directionalLight {
  direction: [-0.4, -1, -0.5],
  color:     [0.5, 0.6, 0.85],
  intensity: 0.4
}

plane {
  normal:   [0, 1, 0],
  distance: -0.1,
  material: material { color: [0.4, 0.4, 0.44], roughness: 0.7 }
}

for (let x = 0; x < n; x++) {
  for (let z = 0; z < n; z++) {
    box {
      min:       [-tile / 2, -0.1, -tile / 2],
      max:       [tile / 2, 0, tile / 2],
      translate: [(x - (n - 1) / 2) * tile, 0, (z - (n - 1) / 2) * tile],
      material:  (x + z) % 2 == 0 ? dark : light
    }
  }
}

// Two pieces, so the board is a board rather than a pattern.
sphere {
  center:    [-tile * 1.5, 0.26, tile * 0.5],
  radius:    0.26,
  material:  material { color: [0.85, 0.3, 0.22], roughness: 0.3 }
}

cone {
  base:       [tile * 2.5, 0, -tile * 1.5],
  baseRadius: 0.26,
  cap:        [tile * 2.5, 0.62, -tile * 1.5],
  capRadius:  0.05,
  material:   material { color: [0.9, 0.88, 0.85], roughness: 0.3 }
}
