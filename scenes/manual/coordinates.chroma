// Which way the axes point, drawn rather than described.
//
// Red runs along +X, green along +Y, blue along +Z, each capped by a sphere at its tip. The
// camera sits at positive Z looking back at the origin, which is the placement the language
// reference asks for -- and with it, +X is on the right of the image and +Z comes towards
// the viewer.

let arm  = 1.6;
let stem = 0.07;

let red   = material { color: [0.85, 0.25, 0.22], roughness: 0.35 };
let green = material { color: [0.35, 0.75, 0.3],  roughness: 0.35 };
let blue  = material { color: [0.3, 0.45, 0.9],   roughness: 0.35 };

camera {
  position: [3.4, 2.6, 4.6],
  lookAt:   [0, 0.35, 0],
  fov:      38
}

pointLight {
  position:  [4, 6, 5],
  color:     [1, 0.97, 0.92],
  intensity: 140,
  radius:    0.6
}

directionalLight {
  direction: [-0.4, -1, -0.5],
  color:     [0.5, 0.6, 0.85],
  intensity: 0.5
}

plane {
  normal:   [0, 1, 0],
  distance: -0.6,
  material: material { color: [0.5, 0.51, 0.55], roughness: 0.7 }
}

union {
  cylinder { base: [0, 0, 0], cap: [arm, 0, 0], radius: stem }
  sphere   { center: [arm, 0, 0], radius: 0.16 }
  material: red
}

union {
  cylinder { base: [0, 0, 0], cap: [0, arm, 0], radius: stem }
  sphere   { center: [0, arm, 0], radius: 0.16 }
  material: green
}

union {
  cylinder { base: [0, 0, 0], cap: [0, 0, arm], radius: stem }
  sphere   { center: [0, 0, arm], radius: 0.16 }
  material: blue
}
