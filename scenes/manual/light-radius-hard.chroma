// Shadow softness, half of a pair: this file and light-radius-soft.chroma differ by one
// number, the light's 'radius'.
//
// Three identical spheres at increasing heights above the floor. At radius 0 the light is an
// idealised point, and all three shadows have the same crisp edge however far the sphere is
// from the floor.

let chalk = material { color: [0.82, 0.8, 0.78], roughness: 0.5 };

camera {
  position: [0, 3.4, 7.5],
  lookAt:   [0, 0.9, 0],
  fov:      38
}

pointLight {
  position:  [0, 7, 2.5],
  color:     [1, 0.97, 0.92],
  intensity: 90,
  radius:    0
}

plane {
  normal:   [0, 1, 0],
  distance: 0,
  material: material { color: [0.6, 0.6, 0.62], roughness: 0.7 }
}

for (let i = 0; i < 3; i++) {
  sphere {
    center:   [-2.6 + i * 2.6, 0.55 + i * 0.85, 0],
    radius:   0.5,
    material: chalk
  }
}
