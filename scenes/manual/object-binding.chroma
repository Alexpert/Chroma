// 'let' holds a whole subtree, and 'object' is what places a copy of it.
//
// The bracket below is written once. Referencing the binding INSTANTIATES it, so the four
// pieces here are four independent solids -- and a reference on its own takes no modifiers,
// because 'bracket { translate: ... }' would read as a node type called 'bracket'. That is
// the entire reason 'object' exists: it wraps exactly one solid and carries the placement and
// the material that the reference cannot.
//
// It costs nothing. A 'union' of one operand is that operand, so no instruction is emitted
// for the wrapper.

let pewter = material { color: [0.72, 0.72, 0.75], roughness: 0.35 };
let brass  = material { color: [0.85, 0.65, 0.28], roughness: 0.3, metallic: 1 };

// One bracket: a plate with a hole in it and a peg through the hole.
let bracket = difference {
  union {
    box      { min: [-0.7, 0, -0.5], max: [0.7, 0.22, 0.5] }
    cylinder { base: [0, 0.22, 0], cap: [0, 1.1, 0], radius: 0.16 }
  }

  cylinder { base: [-0.45, -0.1, 0], cap: [-0.45, 0.32, 0], radius: 0.22 }
};

render { exposure: 0.9 }

camera {
  position: [0, 2.6, 6.4],
  lookAt:   [0, 0.5, 0],
  fov:      38
}

pointLight {
  position:  [3, 5.5, 4],
  color:     [1, 0.97, 0.92],
  intensity: 200,
  radius:    0.5
}

directionalLight {
  direction: [-0.4, -1, -0.5],
  color:     [0.5, 0.6, 0.85],
  intensity: 0.5
}

plane {
  normal:   [0, 1, 0],
  distance: 0,
  material: material { color: [0.42, 0.42, 0.46], roughness: 0.7 }
}

object { bracket, translate: [-2.4, 0, 0], material: pewter }
object { bracket, translate: [-0.8, 0, 0], rotate: [0, 25, 0], material: brass }
object { bracket, translate: [0.8, 0, 0], rotate: [0, -25, 0], material: brass }
object { bracket, translate: [2.4, 0, 0], material: pewter }
