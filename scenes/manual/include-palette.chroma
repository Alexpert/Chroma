// 'include' reuses a file. Everything coloured here is coloured by palette.chroma, which this
// scene never names beyond the one line below.
//
// The path is resolved relative to THIS file rather than to the working directory, so a folder
// of fragments that include each other keeps working wherever the renderer is run from. A
// diagnostic raised inside the fragment names the fragment and its own line and column.

include "palette.chroma";

render { exposure: 0.9 }

camera {
  position: [0, 2.2, 7],
  lookAt:   [0, 0.75, 0],
  fov:      36
}

pointLight {
  position:  [3, 5.5, 4.5],
  color:     [1, 0.97, 0.92],
  intensity: 220,
  radius:    0.5
}

directionalLight {
  direction: [-0.4, -1, -0.5],
  color:     [0.5, 0.6, 0.85],
  intensity: 0.45
}

plane {
  normal:   [0, 1, 0],
  distance: 0,
  material: pewter
}

sphere   { center: [-2.6, 0.75, 0], radius: 0.75, material: clay }
box      { min: [-0.7, 0, -0.7], max: [0.7, 1.4, 0.7], translate: [-0.85, 0, 0], material: jade }
cylinder { base: [1.2, 0, 0], cap: [1.2, 1.5, 0], radius: 0.6, material: brass }

// The fragment's function, called from here: its body still reads the fragment's own scope.
sphere { center: [3.2, 0.75, 0], radius: 0.75, material: tinted([0.35, 0.45, 0.8]) }
