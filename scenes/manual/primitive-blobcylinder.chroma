// A 'blobCylinder' spreads its field along the SEGMENT from its 'base' to its 'cap' rather than
// around a point, which makes it a capsule with rounded ends.
//
// It merges with its neighbours exactly as a 'blobSphere' does, because the surface belongs to
// the sum of the fields and not to any one component -- which is what turns three separate legs
// into one joint here, with no seam where they meet.
//
// The two kinds mix freely inside one blob, and the sphere on the right shows it: the field is
// the same formula either way, measured to a segment instead of to a point.

let clay = material { color: [0.78, 0.45, 0.32], roughness: 0.3 };

render { exposure: 0.9 }

camera {
  position: [0, 2.2, 6.6],
  lookAt:   [0, 0.85, 0],
  fov:      40
}

pointLight {
  position:  [3, 6, 5],
  color:     [1, 0.97, 0.92],
  intensity: 240,
  radius:    0.4
}

directionalLight {
  direction: [-0.4, -1, -0.5],
  color:     [0.5, 0.6, 0.85],
  intensity: 0.4
}

plane {
  normal:   [0, 1, 0],
  distance: 0,
  material: material { color: [0.5, 0.5, 0.54], roughness: 0.7 }
}

// Three capsules meeting at one point, which is the shape spheres alone cannot make.
blob {
  threshold: 0.5,

  blobCylinder { base: [0, 1.4, 0], cap: [0, 0.1, 0],     radius: 0.55 }
  blobCylinder { base: [0, 1.4, 0], cap: [-1.1, 0.1, 0],  radius: 0.55 }
  blobCylinder { base: [0, 1.4, 0], cap: [0.5, 0.1, 0.9], radius: 0.55 }

  translate: [-1.7, 0, 0],
  material:  clay
}

// One of each, overlapping. The seam between them is not visible because there is not one.
blob {
  threshold: 0.5,

  blobCylinder { base: [-0.8, 0.7, 0], cap: [0.4, 0.7, 0], radius: 0.6 }
  blobSphere   { center: [0.8, 0.9, 0], radius: 0.9 }

  translate: [1.9, 0, 0],
  material:  material { color: [0.35, 0.55, 0.75], roughness: 0.25 }
}
