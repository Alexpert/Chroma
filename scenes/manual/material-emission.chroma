// 'emission' makes a solid a light you can see, and the only light in this file is the panel
// hanging over the room.
//
// There is no 'pointLight' here at all. The panel is a box with an emission far above 1 --
// emission is radiance and a light is not limited to the brightness of white paint -- and
// every lit pixel below it arrived by a ray that happened to bounce into it. That is also why
// this image needs more samples than any other in the manual: an emissive solid is found by
// chance rather than aimed at.

let warm = material { emission: [14, 11.5, 8] };

render { maxBounces: 6, exposure: 0.85 }

camera {
  position: [0, 2.1, 7.2],
  lookAt:   [0, 1.9, 0],
  fov:      42
}

plane { normal: [0, 1, 0],  distance: 0,  material: material { color: [0.6, 0.6, 0.62], roughness: 0.7 } }
plane { normal: [0, 0, 1],  distance: -4, material: material { color: [0.65, 0.64, 0.6], roughness: 0.85 } }
plane { normal: [1, 0, 0],  distance: -4, material: material { color: [0.6, 0.3, 0.25], roughness: 0.85 } }
plane { normal: [-1, 0, 0], distance: -4, material: material { color: [0.28, 0.4, 0.6], roughness: 0.85 } }
plane { normal: [0, -1, 0], distance: -5, material: material { color: [0.65, 0.65, 0.66], roughness: 0.9 } }

// The light itself: a solid, so it is visible in the picture and casts nothing.
box {
  min:      [-1.3, 4.3, -1.3],
  max:      [1.3, 4.45, 1.3],
  material: warm
}

sphere {
  center:   [-1.1, 0.8, 0.3],
  radius:   0.8,
  material: material { color: [0.8, 0.78, 0.74], roughness: 0.4 }
}

box {
  min:       [-0.7, 0, -0.7],
  max:       [0.7, 1.4, 0.7],
  rotate:    [0, 24, 0],
  translate: [1.3, 0, -0.4],
  material:  material { color: [0.75, 0.7, 0.55], roughness: 0.5 }
}
