// A beam through haze, half of a pair: this file and medium-anisotropy-forward.chroma differ
// by one number, the medium's 'anisotropy'.
//
// At 0 the haze scatters equally in every direction, so what leaves the beam towards the eye
// is no more than what leaves it any other way. The shaft is there -- the window bounds the
// lit volume, and that alone gives it edges -- but it is broad, soft and barely brighter than
// the milky room around it.

render { maxBounces: 16, exposure: 1 }

let haze = material {
  transmission: 1,
  ior:          1,
  scattering:   0.09,
  anisotropy:   0
};

let wall = material { color: [0.5, 0.5, 0.52], roughness: 1 };

camera {
  position: [1.2, 0.2, 8.2],
  lookAt:   [-0.6, -0.6, 0],
  fov:      50
}

pointLight {
  position:  [-9.5, 5.4, -0.5],
  color:     [1, 0.97, 0.9],
  intensity: 2100,
  radius:    0.45
}

// A sealed room. The shells overlap at the corners rather than meeting edge to edge: a gap of
// zero width is still a hole, and a point light finds it.
box { min: [-4.4, -3.2, -4.6], max: [4.4, -3.0, 7.4], material: wall }
box { min: [-4.4,  3.0, -4.6], max: [4.4,  3.2, 7.4], material: wall }
box { min: [-4.4, -3.2, -4.6], max: [4.4,  3.2, -4.4], material: wall }
box { min: [ 4.2, -3.2, -4.6], max: [4.4,  3.2, 7.4], material: wall }

// The left wall, with a window cut out of it. A bounded aperture is what gives the lit volume
// edges; without one there is a glow rather than a shaft.
difference {
  box { min: [-4.4, -3.2, -4.6], max: [-4.2, 3.2, 7.4] }
  box { min: [-4.5, 0.6, -1.9],  max: [-4.1, 2.6, 0.9] }

  material: wall
}

// Inset from the walls: two coincident faces leave the span algebra deciding a tie between
// them, and it stops short of the camera because a ray that starts inside a medium does not
// know that it is.
box {
  min:      [-4.15, -2.95, -4.35],
  max:      [4.15, 2.95, 6],
  material: haze
}
