// 'mesh' loads a triangle mesh from an .obj or .stl file and treats it as a solid, which means
// it needs a well-defined inside: the file has to be closed, manifold and wound consistently, or
// it is refused with a diagnostic saying which of the three it failed.
//
// Left to right: the Utah teapot shaded by its faces, the same file shaded by interpolated
// vertex normals, and the Stanford bunny with a sphere subtracted from it. The last one is what
// "a mesh is a solid" buys: the scoop shows a lit interior, not a hole through to the sky.
//
// The teapot is published open at its rim, so it is closed here with 'close: true'. The bunny
// needs nothing.

let clay  = material { color: [0.78, 0.45, 0.32], roughness: 0.4 };
let brass = material { color: [0.85, 0.65, 0.28], roughness: 0.25, metallic: 1 };
let ivory = material { color: [0.82, 0.8, 0.74], roughness: 0.35 };
let jade  = material { color: [0.3, 0.62, 0.48], roughness: 0.2 };

camera {
  position: [0, 2.5, 9.5],
  lookAt:   [0, 1, 0],
  fov:      42
}

pointLight {
  position:  [4, 7, 6],
  color:     [1, 0.97, 0.92],
  intensity: 340,
  radius:    0.5
}

directionalLight {
  direction: [-0.4, -1, -0.5],
  color:     [0.5, 0.6, 0.85],
  intensity: 0.6
}

plane {
  normal:   [0, 1, 0],
  distance: 0,
  material: material { color: [0.5, 0.5, 0.54], roughness: 0.7 }
}

// Faceted, which is what a mesh does by default: each triangle shades by its own plane.
mesh {
  file:      "../assets/teapot.obj",
  close:     true,
  material:  clay,
  translate: [-0.217, 0, 0],
  scale:     0.44,
  translate: [-3.2, 0, 0]
}

// The same triangles, with 'smooth' on. The silhouette does not change -- the tessellation is
// still there -- and only the shading does.
mesh {
  file:      "../assets/teapot.obj",
  close:     true,
  smooth:    true,
  material:  brass,
  translate: [-0.217, 0, 0],
  scale:     0.44
}

// A mesh is an ordinary CSG operand, so it subtracts like anything else.
difference {
  mesh {
    file:      "../assets/bunny.stl",
    smooth:    true,
    translate: [-30.32, -1.89, -59.22],
    rotate:    [-90, 0, 0],
    scale:     0.019,
    translate: [3.2, 1.025, 0]
  }

  sphere {
    center:   [3.75, 1.2, 0.75],
    radius:   0.8,
    material: jade
  }

  material: ivory
}
