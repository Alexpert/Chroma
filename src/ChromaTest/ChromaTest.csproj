<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Required to pass pinned pointers to the GL buffer/attribute functions. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <!-- The HUD. Pulls ImGui.NET and its native cimgui binary; the backend targets
         GLSL 330, so it costs no OpenGL version bump. -->
    <PackageReference Include="Silk.NET.OpenGL.Extensions.ImGui" Version="2.23.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shaders are loaded from disk at startup, so they must sit next to the binary.
         PreserveNewest means editing a .vert/.frag and re-running is enough. -->
    <None Update="Shaders\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChromaTest.Core\ChromaTest.Core.csproj" />
  </ItemGroup>

</Project>
